<?xml version="1.0" encoding="utf-8"?>
<mujoco model="t_stairs_task">
    <compiler angle="radian" meshdir="meshes" autolimits="true"/>
    <option timestep="0.002" gravity="0 0 -9.81" wind="0 0 0" integrator="implicitfast" density="1.225" viscosity="1.8e-5" />
    <visual>
        <global realtime="1" />
        <quality shadowsize="2048" numslices="28" offsamples="4" />
        <headlight diffuse="1 1 1" specular="0.5 0.5 0.5" active="1" />
    </visual>
    
    <asset>
        <texture type="skybox" file="./assets/desert.png" gridsize="3 4" gridlayout=".U..LFRB.D.." />
        <texture name="plane" type="2d" builtin="checker" rgb1=".1 .1 .1" rgb2=".9 .9 .9" width="512" height="512" mark="cross" markrgb=".8 .8 .8" />
        <material name="plane" reflectance="0.3" texture="plane" texrepeat="1 1" texuniform="true" />
        
        <!-- 台阶材质：橘黄色水性乳胶漆 -->
        <material name="stair_mat" rgba="1.0 0.7 0.1 1.0" shininess="1.0" specular="0.3"/>
        <!-- 顶部启动区材质：稍亮的黄色 (模拟图片中的亮色区域，虽然实际要求颜色一致，但为了视觉区分可选) -->
        <material name="start_zone_mat" rgba="1.0 0.8 0.2 1.0" shininess="0.3" specular="0.3"/>
    </asset>

    <worldbody>
        <geom name="floor" pos="0 0 0" size="10 10 .1" type="plane" material="plane" condim="3"/>
        <light directional="true" ambient=".3 .3 .3" pos="30 30 30" dir="0 -2 -1" diffuse=".5 .5 .5" specular=".5 .5 .5" />

        <!-- ================= T字形台阶 ================= -->
        <!-- 坐标系说明：以顶部方台中心为 (0,0)，地面为 Z=0 -->
        <body name="t_staircase" pos="0 0 0">
            
            <!-- 1. 顶部平台 (Top Platform) -->
            <!-- 尺寸: 1.0x1.0m, 高0.4m -->
            <geom name="top_platform" type="box" size="0.5 0.5 0.2" pos="0 0 0.2" material="start_zone_mat"/>

            <!-- 2. 左侧台阶 (Left Stairs) - 沿 X 轴负方向 -->
            <!-- 步深0.3m, 宽度1.0m (size y=0.5) -->
            
            <!-- Level 3 (高0.3m) -->
            <geom name="left_step_3" type="box" size="0.15 0.5 0.15" pos="-0.65 0 0.15" material="stair_mat"/>
            <!-- Level 2 (高0.2m) -->
            <geom name="left_step_2" type="box" size="0.15 0.5 0.10" pos="-0.95 0 0.10" material="stair_mat"/>
            <!-- Level 1 (高0.1m) -->
            <geom name="left_step_1" type="box" size="0.15 0.5 0.05" pos="-1.25 0 0.05" material="stair_mat"/>

            <!-- 3. 右侧台阶 (Right Stairs) - 沿 X 轴正方向 -->
            
            <!-- Level 3 (高0.3m) -->
            <geom name="right_step_3" type="box" size="0.15 0.5 0.15" pos="0.65 0 0.15" material="stair_mat"/>
            <!-- Level 2 (高0.2m) -->
            <geom name="right_step_2" type="box" size="0.15 0.5 0.10" pos="0.95 0 0.10" material="stair_mat"/>
            <!-- Level 1 (高0.1m) -->
            <geom name="right_step_1" type="box" size="0.15 0.5 0.05" pos="1.25 0 0.05" material="stair_mat"/>

            <!-- 4. 前方台阶 (Front Stairs) - 沿 Y 轴负方向 (形成T的竖划) -->
            <!-- 步深0.3m (size y=0.15), 宽度1.0m (size x=0.5) -->
            
            <!-- Level 3 (高0.3m) -->
            <geom name="front_step_3" type="box" size="0.5 0.15 0.15" pos="0 -0.65 0.15" material="stair_mat"/>
            <!-- Level 2 (高0.2m) -->
            <geom name="front_step_2" type="box" size="0.5 0.15 0.10" pos="0 -0.95 0.10" material="stair_mat"/>
            <!-- Level 1 (高0.1m) -->
            <geom name="front_step_1" type="box" size="0.5 0.15 0.05" pos="0 -1.25 0.05" material="stair_mat"/>
            
        </body>

    </worldbody>
</mujoco>