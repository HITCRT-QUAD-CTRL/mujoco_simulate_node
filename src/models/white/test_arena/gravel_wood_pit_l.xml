<body name="gravel_wood_pit">

  <!-- ================= 护栏（完整 L 形外框，宽度20mm） ================= -->

  <!-- 上边（完整） -->
  <geom type="box"
        size="1.0 0.01 0.075"
        pos="0 1.01 0.075"
        rgba="0.874 0.459 0 1"/>

  <!-- 左边（完整） -->
  <geom type="box"
        size="0.01 1.0 0.075"
        pos="-1.01 0 0.075"
        rgba="0.874 0.459 0 1"/>

  <!-- 右上边 -->
  <geom type="box"
        size="0.01 0.5 0.075"
        pos="1.01 0.5 0.075"
        rgba="0.874 0.459 0 1"/>

  <!-- 下左边 -->
  <geom type="box"
        size="0.5 0.01 0.075"
        pos="-0.5 -1.01 0.075"
        rgba="0.874 0.459 0 1"/>

  <!-- 右上角块（上边和右上边的连接角） -->
  <geom type="box"
        size="0.01 0.01 0.075"
        pos="1.01 1.01 0.075"
        rgba="0.874 0.459 0 1"/>

  <!-- 左下角块（左边和下左边的连接角） -->
  <geom type="box"
        size="0.01 0.01 0.075"
        pos="-1.01 -1.01 0.075"
        rgba="0.874 0.459 0 1"/>

  <!-- 左上角块 -->
  <geom type="box"
        size="0.01 0.01 0.075"
        pos="-1.01 1.01 0.075"
        rgba="0.874 0.459 0 1"/>

  <!-- 内凹竖 -->
  <geom type="box"
        size="0.01 0.5 0.075"
        pos="0.01 -0.5 0.075"
        rgba="0.874 0.459 0 1"/>

  <!-- 内凹横 -->
  <geom type="box"
        size="0.5 0.01 0.075"
        pos="0.5 0.01 0.075"
        rgba="0.874 0.459 0 1"/>

  <!-- 内凹角块（内凹竖和内凹横的连接角） -->
  <geom type="box"
        size="0.01 0.01 0.075"
        pos="0.01 0.01 0.075"
        rgba="0.874 0.459 0 1"/>

  <!-- 内凹竖与下左边的连接角块 -->
  <geom type="box"
        size="0.01 0.01 0.075"
        pos="0.01 -1.01 0.075"
        rgba="0.874 0.459 0 1"/>

  <!-- 内凹横与右上边的连接角块 -->
  <geom type="box"
        size="0.01 0.01 0.075"
        pos="1.01 0.01 0.075"
        rgba="0.874 0.459 0 1"/>

  <!-- ================= 斜边围栏（45度，从 (0, 1.0) 到 (1.0, 0)） ================= -->
  <!-- 斜边围栏的长度约为 √2 ≈ 1.414m，从中心点到中心的距离 -->
  <geom type="box"
        name="diagonal_rail"
        size="0.01 0.707 0.075"
        pos="-0.5 0.5 0.075"
        quat="0.92388 0 0 0.38268"
        rgba="0.874 0.459 0 1"/>

</body>
