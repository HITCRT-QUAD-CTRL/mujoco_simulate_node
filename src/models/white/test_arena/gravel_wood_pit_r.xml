<body name="gravel_wood_pit_mirror_x">

  <!-- ================= 护栏（完整 L 形外框，宽度20mm） ================= -->

  <!-- 上边（完整） → 原来在 y=+1.01，现在到 y=-1.01 -->
  <geom type="box"
        size="1.0 0.01 0.75"
        pos="0 -1.01 0.75"
        rgba="0.874 0.459 0 1"/>

  <!-- 左边（完整） -->
  <geom type="box"
        size="0.01 1.0 0.75"
        pos="-1.01 0 0.75"
        rgba="0.874 0.459 0 1"/>

  <!-- 右下边（原右上） -->
  <geom type="box"
        size="0.01 0.5 0.75"
        pos="1.01 -0.5 0.75"
        rgba="0.874 0.459 0 1"/>

  <!-- 上左边（原下左） -->
  <geom type="box"
        size="0.5 0.01 0.75"
        pos="-0.5 1.01 0.75"
        rgba="0.874 0.459 0 1"/>

  <!-- 右下角块 -->
  <geom type="box"
        size="0.01 0.01 0.75"
        pos="1.01 -1.01 0.75"
        rgba="0.874 0.459 0 1"/>

  <!-- 左上角块 -->
  <geom type="box"
        size="0.01 0.01 0.75"
        pos="-1.01 1.01 0.75"
        rgba="0.874 0.459 0 1"/>

  <!-- 左下角块 -->
  <geom type="box"
        size="0.01 0.01 0.75"
        pos="-1.01 -1.01 0.75"
        rgba="0.874 0.459 0 1"/>

  <!-- 内凹竖（y 取反） -->
  <geom type="box"
        size="0.01 0.5 0.75"
        pos="0.01 0.5 0.75"
        rgba="0.874 0.459 0 1"/>

  <!-- 内凹横（y 取反） -->
  <geom type="box"
        size="0.5 0.01 0.75"
        pos="0.5 -0.01 0.75"
        rgba="0.874 0.459 0 1"/>

  <!-- 内凹角块 -->
  <geom type="box"
        size="0.01 0.01 0.75"
        pos="0.01 -0.01 0.75"
        rgba="0.874 0.459 0 1"/>

  <!-- 内凹竖与上左边的连接角 -->
  <geom type="box"
        size="0.01 0.01 0.75"
        pos="0.01 1.01 0.75"
        rgba="0.874 0.459 0 1"/>

  <!-- 内凹横与右下边的连接角 -->
  <geom type="box"
        size="0.01 0.01 0.75"
        pos="1.01 -0.01 0.75"
        rgba="0.874 0.459 0 1"/>

  <!-- ================= 斜边围栏（方向镜像） ================= -->
  <geom type="box"
        name="diagonal_rail_mirror_x"
        size="0.01 0.707 0.75"
        pos="-0.5 -0.5 0.75"
        quat="0.92388 0 0 -0.38268"
        rgba="0.874 0.459 0 1"/>

</body>
