<?xml version="1.0" encoding="utf-8"?>
<mujoco model="template">
    <compiler angle="radian" meshdir="meshes" autolimits="true"/>
    <option timestep="0.002" gravity="0 0 -9.81" wind="0 0 0" integrator="implicitfast"
        density="1.225"
        viscosity="1.8e-5" />
    <visual>
        <global realtime="1" />
        <quality shadowsize="2048" numslices="28" offsamples="4" />
        <headlight diffuse="1 1 1" specular="0.5 0.5 0.5" active="1" />
        <rgba fog="1 0 0 1" haze="1 1 1 1" />
    </visual>
    <asset>
        <texture type="skybox" file="./assets/desert.png"
            gridsize="3 4" gridlayout=".U..LFRB.D.." />
        <texture name="plane" type="2d" builtin="checker" rgb1=".1 .1 .1" rgb2=".9 .9 .9"
            width="512" height="512" mark="cross" markrgb=".8 .8 .8" />
        <material name="plane" reflectance="0.3" texture="plane" texrepeat="1 1" texuniform="true" />
        <!-- 材质：橘黄色水性乳胶漆 -->
        <material name="orange" rgba="1.0 0.7 0.1 1.0" shininess="1.0" specular="1.0"/>

        <mesh name="small_slope" vertex="0 0 0 0 -1 0 -0.8 0 0 -0.8 -1 0 0 0 0.2 0 -1 0.2" />
        <mesh name="big_slope1" vertex="0 0 0 -3 0 0 0 1 0 -3 1 0 0 1 0.2 -3 1 0.2" />
        <mesh name="big_slope2" vertex="0 0 0 -4 0 0 0 1 0 -4 1 0 0 0 0.2 -4 0 0.2" />

    </asset>
    <worldbody>
        <geom name="floor" pos="0 0 0" size="10 10 .1" type="plane" material="plane" condim="3"/>
        <light directional="true" ambient=".3 .3 .3" pos="30 30 30" dir="0 -2 -1"
            diffuse=".5 .5 .5" specular=".5 .5 .5" />
        
        <body name="platform" pos="0 0 0" euler="0 0 0">
            <!-- 小斜坡A  -->
            <geom type="mesh" mesh="small_slope" pos="-1 0 0" material="orange"/>
            <!-- 木桥A -->
            <body name="bridge A" pos="0.0 0 0">
                <geom type="box" size="0.5 0.5 0.1" pos="-0.5 -0.5 0.1" material="orange"/>
                <geom type="box" size="0.5 0.2 0.1" pos="-0.5 -1.35 0.1" material="orange"/>
                <geom type="box" size="0.5 0.2 0.1" pos="-0.5 -1.9 0.1" material="orange"/>
                <geom type="box" size="0.5 0.2 0.1" pos="-0.5 -2.45 0.1" material="orange"/>
                <geom type="box" size="0.5 0.2 0.1" pos="-0.5 -3 0.1" material="orange"/>
                <geom type="box" size="0.5 0.2 0.1" pos="-0.5 -3.55 0.1" material="orange"/>
                <geom type="box" size="1 0.5 0.1" pos="-1 -4.4 0.1" material="orange"/>
            </body>
            <!-- 小斜坡B -->
            <geom type="mesh" mesh="small_slope" pos="-1 -3.9 0" euler="0 0 -1.5708 " material="orange"/>
            <!-- 木桥B -->
            <body name="bridge B" pos="-2 -4.9 0">
                <geom type="box" size="0.75 0.1 0.1" pos="-0.75 0.2 0.1" material="orange"/>
                <geom type="box" size="0.75 0.1 0.1" pos="-0.75 0.5 0.1" material="orange"/>
                <geom type="box" size="0.75 0.1 0.1" pos="-0.75 0.8 0.1" material="orange"/>
                <geom type="box" size="0.5 0.5 0.1" pos="-2 0.5 0.1" material="orange"/>
            </body>
            <!-- 大斜坡 -->
            <body name="big_slope" pos="-4.5 -4.9 0">
                <geom type="mesh" mesh="big_slope1" pos="0 0 0" material="orange" />
                <geom type="mesh" mesh="big_slope2" pos="1 1 0" material="orange" />
            </body>
        </body>
    </worldbody>
</mujoco>