<mujoco model="white scene">

  <!-- x = -2566 y = -2916-->
  <include file="./white.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <!-- <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="plane" reflectance="0.3" texture="plane" texrepeat="1 1" texuniform="true" /> -->
    <mesh name="small_slope" vertex="0 0 0 0 -1 0 -0.8 0 0 -0.8 -1 0 0 0 0.2 0 -1 0.2" />
    <mesh name="big_slope1" vertex="0 0 0 -4 0 0 0 1 0 -4 1 0 0 1 0.2 -4 1 0.2" />
    <mesh name="big_slope2" vertex="0 0 0 -4 0 0 0 1 0 -4 1 0 0 0 0.2 -4 0 0.2" />
    <!-- 材质：橘黄色水性乳胶漆 -->
    <material name="orange" rgba="0.875 0.459 0 1" shininess="1.0" specular="1.0"/>


  </asset>
  


  <!-- <compiler angle="radian" meshdir="meshes" autolimits="true"/> -->
