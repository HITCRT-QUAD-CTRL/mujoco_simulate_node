  <worldbody>
    <!-- <light pos="0 0 1.5" dir="0 0 -1" directional="true"/> -->
    <!-- <geom name="floor" size="5 5 0.05" type="plane" material="groundplane"/> -->
    <!-- ================= 场地 1（下方） ================= -->
    <!-- 地面 -->
    <!-- <light
      name="field1_light"
      pos="0 -3 4"
      dir="0 0 -1"
      directional="true"
